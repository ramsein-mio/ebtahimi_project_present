{
  "name": "pardis-present",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "pardis_present_db",
      "database_name": "pardis-present-db",
      "database_id": "090cc118-565c-4eed-8012-48e90186850d"
    }
  ]
}
