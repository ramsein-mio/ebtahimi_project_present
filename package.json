{
  "name": "pardis-presentations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "typecheck": "tsc -b --pretty false",
    "cf:dev": "npm run build && npx --yes wrangler@4 dev",
    "cf:deploy": "npm run build && npx --yes wrangler@4 deploy",
    "cf:deploy:dry": "npm run build && npx --yes wrangler@4 deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@web-ppt/core": "0.5.0-beta.2",
    "@web-ppt/edit-core": "0.5.0-beta.2",
    "d3-shape": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/d3-shape": "^3.1.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
